# Team Tasks environment variables
# Copy to .env.local for local development. Set production values in Portainer.

NEXT_PUBLIC_BASE_URL="https://tuduvia.com"
APP_URL="https://tuduvia.com"
AUTH_SECRET="generate-a-long-random-secret"
MOMENTUM_CRON_SECRET="generate-another-long-random-secret"

# Future database-backed SaaS storage.
DATABASE_URL="postgresql://teamtasks:teamtasks@localhost:5432/teamtasks?schema=public"

# Optional email delivery. Registered users also receive invitations in-app.
RESEND_API_KEY=""
RESEND_FROM="Tuduvia <noreply@mail.tuduvia.com>"
RESEND_REPLY_TO="support@tuduvia.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
UPLOAD_DIR="/app/uploads"

# Tuduvia Garden Rive widget. Off by default for safe rollout.
NEXT_PUBLIC_TUDUVIA_GARDEN_RIVE_ENABLED="false"
TUDUVIA_GARDEN_RIVE_ENABLED="false"
NEXT_PUBLIC_TUDUVIA_GARDEN_RIVE_SRC="/assets/garden/rive/plant_daisy_stage_01_v1.riv"

# Better Auth social providers. Configure callback URLs as:
# https://your-domain.com/api/auth/callback/google
# https://your-domain.com/api/auth/callback/github
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
BETTER_AUTH_TRUSTED_ORIGINS=""

# Sentry error monitoring
NEXT_PUBLIC_SENTRY_DSN="https://ff926f340bbf35161b3672e0d2074c5a@o4511556643323904.ingest.us.sentry.io/4511556652236800"
SENTRY_DSN="https://ff926f340bbf35161b3672e0d2074c5a@o4511556643323904.ingest.us.sentry.io/4511556652236800"
# Generate at https://sentry.io/settings/auth-tokens/ (scopes: project:releases, org:read)
SENTRY_AUTH_TOKEN=""

# Production-only values for docker-compose.prod.yml.
# Use a long URL-safe value: letters, numbers, hyphens, underscores.
POSTGRES_PASSWORD="replace-with-a-long-url-safe-password"
CF_TUNNEL_TOKEN="replace-with-a-new-cloudflare-tunnel-token"
