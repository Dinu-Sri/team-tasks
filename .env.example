# Team Tasks environment variables
# Copy to .env.local for local development. Set production values in Portainer.

NEXT_PUBLIC_BASE_URL="https://todo.clossyan.com"
APP_URL="https://todo.clossyan.com"
AUTH_SECRET="generate-a-long-random-secret"

# Future database-backed SaaS storage.
DATABASE_URL="postgresql://teamtasks:teamtasks@localhost:5432/teamtasks?schema=public"

# Optional email delivery. Registered users also receive invitations in-app.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Production-only values for docker-compose.prod.yml.
# Use a long URL-safe value: letters, numbers, hyphens, underscores.
POSTGRES_PASSWORD="replace-with-a-long-url-safe-password"
CF_TUNNEL_TOKEN="replace-with-a-new-cloudflare-tunnel-token"
