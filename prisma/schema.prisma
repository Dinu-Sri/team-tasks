generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  memberships  Membership[]
  createdTasks Task[]       @relation("CreatedTasks")
  assignments  TaskMember[]
  sentInvites  Invite[]     @relation("InviteSender")
  invitations  Invite[]     @relation("InvitedUser")
  notifications Notification[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Team {
  id          String       @id @default(cuid())
  name        String
  description String?
  memberships Membership[]
  tasks       Task[]
  invites     Invite[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  id        String   @id @default(cuid())
  role      Role     @default(MEMBER)
  userId    String
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  note        String?
  status      TaskStatus   @default(OPEN)
  priority    Priority     @default(NORMAL)
  dueAt       DateTime?
  completedAt DateTime?
  creatorId   String
  teamId      String
  creator     User         @relation("CreatedTasks", fields: [creatorId], references: [id])
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignees   TaskMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([teamId, status, dueAt])
}

model TaskMember {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
}

model Invite {
  id            String       @id @default(cuid())
  email         String
  token         String       @unique
  status        InviteStatus @default(PENDING)
  role          Role         @default(MEMBER)
  teamId        String
  invitedById   String
  invitedUserId String?
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy     User         @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser   User?        @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  notifications Notification[]
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([teamId, status])
  @@index([email, status])
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String
  recipientId String
  teamId      String?
  inviteId    String?
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  invite      Invite?  @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([recipientId, readAt, createdAt])
}

enum Role {
  OWNER
  MEMBER
}

enum TaskStatus {
  OPEN
  DONE
}

enum Priority {
  NORMAL
  HIGH
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}
