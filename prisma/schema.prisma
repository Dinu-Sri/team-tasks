generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  emailVerified       Boolean               @default(false)
  name                String
  image               String?
  passwordHash        String                @default("")
  authAccounts        Account[]
  sessions            Session[]
  memberships         Membership[]
  createdTasks        Task[]                @relation("CreatedTasks")
  completedTasks      Task[]                @relation("CompletedTasks")
  editedTasks         Task[]                @relation("EditedTasks")
  assignments         TaskMember[]
  sentInvites         Invite[]              @relation("InviteSender")
  invitations         Invite[]              @relation("InvitedUser")
  notifications       Notification[]
  momentumProfile     MomentumProfile?
  momentumDays        MomentumDay[]
  achievements        MomentumAchievement[]
  questContributions  QuestContribution[]
  productEvents       ProductEvent[]
  comments            TaskComment[]
  commentMentions     CommentMention[]
  commentReceipts     CommentReceipt[]
  uploadedAttachments TaskAttachment[]
  onboardingProgress  OnboardingProgress[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}

model OnboardingProgress {
  id          String   @id @default(cuid())
  userId      String
  tourName    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tourName])
  @@index([tourName, completedAt])
}

model Team {
  id                  String                    @id @default(cuid())
  name                String
  description         String?
  timeZone            String                    @default("UTC")
  organizationName    String?
  organizationLogo    String?
  useOrganizationIcon Boolean                   @default(false)
  memberships         Membership[]
  organizationDomains OrganizationDomain[]
  tasks               Task[]
  invites             Invite[]
  quests              TeamQuest[]
  productEvents       ProductEvent[]
  featureSettings     TeamFeatureSettings?
  billingSubscription BillingSubscription?
  billingUsage        WorkspaceUsageSnapshot?
  billingEvents       BillingEvent[]
  invoices            Invoice[]
  billingOverrides    AdminBillingOverride[]
  couponRedemptions   BillingCouponRedemption[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
}

model BillingPlan {
  id                    String                 @id
  code                  String                 @unique
  name                  String
  description           String
  monthlyPriceLkr       Int?
  yearlyPriceLkr        Int?
  maxWorkspaces         Int?
  maxMembers            Int?
  maxActiveTasks        Int?
  maxStorageMb          Int?
  maxFileSizeMb         Int?
  historyDays           Int?
  customBranding        Boolean                @default(false)
  advancedRoles         Boolean                @default(false)
  auditLogs             Boolean                @default(false)
  prioritySupport       Boolean                @default(false)
  sortOrder             Int                    @default(0)
  active                Boolean                @default(true)
  subscriptions         BillingSubscription[]
  adminBillingOverrides AdminBillingOverride[]
  invoices              Invoice[]
  coupons               BillingCoupon[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model BillingSubscription {
  id                     String          @id @default(cuid())
  teamId                 String          @unique
  planId                 String
  status                 BillingStatus   @default(ACTIVE)
  billingProvider        BillingProvider @default(INTERNAL)
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  graceUntil             DateTime?
  cancelAtPeriodEnd      Boolean         @default(false)
  overrideReason         String?
  team                   Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  plan                   BillingPlan     @relation(fields: [planId], references: [id])
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([planId])
  @@index([status, currentPeriodEnd])
  @@index([billingProvider, providerSubscriptionId])
}

model WorkspaceUsageSnapshot {
  teamId         String   @id
  activeMembers  Int      @default(0)
  pendingInvites Int      @default(0)
  activeTasks    Int      @default(0)
  storageBytes   BigInt   @default(0)
  lastCalculated DateTime @default(now())
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model BillingEvent {
  id              String          @id @default(cuid())
  teamId          String?
  provider        BillingProvider
  providerEventId String
  eventType       String
  verified        Boolean         @default(false)
  rawPayload      Json
  processedAt     DateTime?
  team            Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())

  @@unique([provider, providerEventId])
  @@index([teamId, createdAt])
}

model Invoice {
  id                String         @id @default(cuid())
  teamId            String
  planId            String?
  couponId          String?
  number            String         @unique
  status            InvoiceStatus  @default(DRAFT)
  billingCycle      BillingCycle   @default(MONTHLY)
  originalAmountLkr Int?
  amountLkr         Int
  discountAmountLkr Int            @default(0)
  discountCode      String?
  description       String
  dueAt             DateTime?
  paidAt            DateTime?
  providerPaymentId String?
  team              Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  plan              BillingPlan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  coupon            BillingCoupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([teamId, status])
  @@index([planId])
  @@index([couponId])
}

model BillingCoupon {
  id             String                    @id @default(cuid())
  code           String                    @unique
  name           String
  discountType   BillingDiscountType
  percentOff     Int?
  amountOffLkr   Int?
  planId         String?
  billingCycle   BillingCycle?
  maxRedemptions Int?
  maxPerTeam     Int                       @default(1)
  startsAt       DateTime?
  expiresAt      DateTime?
  active         Boolean                   @default(true)
  plan           BillingPlan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  invoices       Invoice[]
  redemptions    BillingCouponRedemption[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([active, expiresAt])
  @@index([planId])
}

model BillingCouponRedemption {
  id                String        @id @default(cuid())
  couponId          String
  teamId            String
  invoiceId         String?
  amountDiscountLkr Int
  coupon            BillingCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  team              Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())

  @@index([couponId, createdAt])
  @@index([teamId, createdAt])
}

model AdminBillingOverride {
  id             String         @id @default(cuid())
  teamId         String
  adminUserId    String
  previousPlanId String?
  newPlanId      String?
  previousStatus BillingStatus?
  newStatus      BillingStatus?
  reason         String
  team           Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  newPlan        BillingPlan?   @relation(fields: [newPlanId], references: [id])
  createdAt      DateTime       @default(now())

  @@index([teamId, createdAt])
  @@index([adminUserId, createdAt])
}

model Membership {
  id        String           @id @default(cuid())
  role      Role             @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  source    MembershipSource @default(MANUAL)
  userId    String
  teamId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([userId, teamId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model OrganizationDomain {
  id                   String    @id @default(cuid())
  teamId               String
  domain               String    @unique
  autoJoin             Boolean   @default(false)
  requireAdminApproval Boolean   @default(false)
  verificationEmail    String?
  dnsTxtName           String?
  dnsTxtValue          String?
  verifiedAt           DateTime?
  team                 Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([teamId])
}

model Task {
  id                 String              @id @default(cuid())
  title              String
  note               String?
  status             TaskStatus          @default(OPEN)
  priority           Priority            @default(NORMAL)
  dueAt              DateTime?
  completedAt        DateTime?
  completedById      String?
  momentumAwardedAt  DateTime?
  creatorId          String
  teamId             String
  editNote           String?
  editedById         String?
  editedAt           DateTime?
  creator            User                @relation("CreatedTasks", fields: [creatorId], references: [id])
  completedBy        User?               @relation("CompletedTasks", fields: [completedById], references: [id], onDelete: SetNull)
  editedBy           User?               @relation("EditedTasks", fields: [editedById], references: [id], onDelete: SetNull)
  team               Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignees          TaskMember[]
  momentumDays       MomentumDay[]
  questContributions QuestContribution[]
  comments           TaskComment[]
  attachments        TaskAttachment[]
  replyForMention    CommentMention?     @relation("ReplyTask")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([teamId, status, dueAt])
}

model TeamFeatureSettings {
  teamId                  String   @id
  commentsEnabled         Boolean  @default(false)
  attachmentsEnabled      Boolean  @default(false)
  memberTaskViewEnabled   Boolean  @default(false)
  finishedTaskViewEnabled Boolean  @default(false)
  attachmentLimitMb       Int      @default(5)
  team                    Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model TaskComment {
  id        String           @id @default(cuid())
  body      String
  taskId    String
  authorId  String
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentions  CommentMention[]
  receipts  CommentReceipt[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([taskId, createdAt])
}

model CommentReceipt {
  id                String      @id @default(cuid())
  commentId         String
  userId            String
  requiresAttention Boolean     @default(false)
  readAt            DateTime?
  comment           TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now())

  @@unique([commentId, userId])
  @@index([userId, readAt, createdAt])
}

model CommentMention {
  id          String      @id @default(cuid())
  commentId   String
  userId      String
  replyTaskId String      @unique
  comment     TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTask   Task        @relation("ReplyTask", fields: [replyTaskId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([commentId, userId])
  @@index([userId, createdAt])
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  uploaderId   String
  originalName String
  storedName   String   @unique
  mimeType     String
  size         Int
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader     User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([taskId, createdAt])
}

model TaskMember {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
}

model Invite {
  id            String         @id @default(cuid())
  email         String
  token         String         @unique
  status        InviteStatus   @default(PENDING)
  role          Role           @default(MEMBER)
  teamId        String
  invitedById   String
  invitedUserId String?
  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy     User           @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser   User?          @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  notifications Notification[]
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([teamId, status])
  @@index([email, status])
}

model Notification {
  id          String           @id @default(cuid())
  title       String
  message     String
  kind        NotificationKind @default(GENERAL)
  href        String?
  dedupeKey   String?          @unique
  recipientId String
  teamId      String?
  inviteId    String?
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  invite      Invite?          @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([recipientId, readAt, createdAt])
}

model MomentumProfile {
  userId           String   @id
  enabled          Boolean  @default(true)
  timeZone         String   @default("UTC")
  workDays         String   @default("1,2,3,4,5")
  reminderHour     Int      @default(16)
  remindersEnabled Boolean  @default(true)
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  totalWins        Int      @default(0)
  shieldCount      Int      @default(0)
  shieldsEarned    Int      @default(0)
  lastWinDate      String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MomentumDay {
  id           String            @id @default(cuid())
  userId       String
  localDate    String
  status       MomentumDayStatus
  sourceTaskId String?
  eligibleAt   DateTime          @default(now())
  resolvedAt   DateTime?
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTask   Task?             @relation(fields: [sourceTaskId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([userId, localDate])
  @@index([userId, status, localDate])
}

model MomentumAchievement {
  id             String    @id @default(cuid())
  userId         String
  badge          BadgeTier
  streakAtUnlock Int
  unlockedAt     DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badge])
  @@index([userId, unlockedAt])
}

model TeamQuest {
  id            String              @id @default(cuid())
  teamId        String
  weekKey       String
  title         String
  targetWins    Int
  status        TeamQuestStatus     @default(ACTIVE)
  startAt       DateTime
  endAt         DateTime
  completedAt   DateTime?
  team          Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contributions QuestContribution[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([teamId, weekKey])
  @@index([teamId, status, startAt])
}

model QuestContribution {
  id           String    @id @default(cuid())
  questId      String
  userId       String
  localDate    String
  sourceTaskId String?
  quest        TeamQuest @relation(fields: [questId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTask   Task?     @relation(fields: [sourceTaskId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@unique([questId, userId, localDate])
  @@index([questId, createdAt])
}

model ProductEvent {
  id         String   @id @default(cuid())
  name       String
  userId     String?
  teamId     String?
  properties Json?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@index([teamId, createdAt])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  PENDING
}

enum MembershipSource {
  MANUAL
  INVITE
  DOMAIN
}

enum TaskStatus {
  OPEN
  DONE
}

enum Priority {
  NORMAL
  HIGH
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum NotificationKind {
  GENERAL
  TASK
  INVITE
  MOMENTUM
  QUEST
  COMMENT
  TEAM
}

enum MomentumDayStatus {
  PENDING
  WIN
  SHIELDED
  MISSED
}

enum BadgeTier {
  SPARK
  RHYTHM
  FLOW
  DRIVE
  PEAK
  LEGACY
}

enum TeamQuestStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum BillingProvider {
  INTERNAL
  MANUAL
  PAYHERE
  ONEPAY
}

enum BillingStatus {
  TRIALING
  ACTIVE
  GRACE
  PAST_DUE
  CANCELED
  COMPED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
  OVERDUE
}

enum BillingCycle {
  MONTHLY
  YEARLY
  MANUAL
  SETUP
}

enum BillingDiscountType {
  PERCENT
  AMOUNT
}
