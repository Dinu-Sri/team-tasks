generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                @id @default(cuid())
  email              String                @unique
  name               String
  passwordHash       String
  memberships        Membership[]
  createdTasks       Task[]                @relation("CreatedTasks")
  completedTasks     Task[]                @relation("CompletedTasks")
  assignments        TaskMember[]
  sentInvites        Invite[]              @relation("InviteSender")
  invitations        Invite[]              @relation("InvitedUser")
  notifications      Notification[]
  momentumProfile    MomentumProfile?
  momentumDays       MomentumDay[]
  achievements       MomentumAchievement[]
  questContributions QuestContribution[]
  productEvents      ProductEvent[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model Team {
  id          String       @id @default(cuid())
  name        String
  description String?
  timeZone    String       @default("UTC")
  memberships Membership[]
  tasks       Task[]
  invites     Invite[]
  quests      TeamQuest[]
  productEvents ProductEvent[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  id        String   @id @default(cuid())
  role      Role     @default(MEMBER)
  userId    String
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
}

model Task {
  id                String              @id @default(cuid())
  title             String
  note              String?
  status            TaskStatus          @default(OPEN)
  priority          Priority            @default(NORMAL)
  dueAt             DateTime?
  completedAt       DateTime?
  completedById     String?
  momentumAwardedAt DateTime?
  creatorId         String
  teamId            String
  creator           User                @relation("CreatedTasks", fields: [creatorId], references: [id])
  completedBy       User?               @relation("CompletedTasks", fields: [completedById], references: [id], onDelete: SetNull)
  team              Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignees         TaskMember[]
  momentumDays      MomentumDay[]
  questContributions QuestContribution[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([teamId, status, dueAt])
}

model TaskMember {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
}

model Invite {
  id            String       @id @default(cuid())
  email         String
  token         String       @unique
  status        InviteStatus @default(PENDING)
  role          Role         @default(MEMBER)
  teamId        String
  invitedById   String
  invitedUserId String?
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy     User         @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser   User?        @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  notifications Notification[]
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([teamId, status])
  @@index([email, status])
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String
  kind        NotificationKind @default(GENERAL)
  href        String?
  dedupeKey   String?  @unique
  recipientId String
  teamId      String?
  inviteId    String?
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  invite      Invite?  @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([recipientId, readAt, createdAt])
}

model MomentumProfile {
  userId           String   @id
  enabled          Boolean  @default(true)
  timeZone         String   @default("UTC")
  workDays         String   @default("1,2,3,4,5")
  reminderHour     Int      @default(16)
  remindersEnabled Boolean @default(true)
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  totalWins        Int      @default(0)
  shieldCount      Int      @default(0)
  shieldsEarned    Int      @default(0)
  lastWinDate      String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MomentumDay {
  id           String            @id @default(cuid())
  userId       String
  localDate    String
  status       MomentumDayStatus
  sourceTaskId String?
  eligibleAt   DateTime          @default(now())
  resolvedAt   DateTime?
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTask   Task?             @relation(fields: [sourceTaskId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([userId, localDate])
  @@index([userId, status, localDate])
}

model MomentumAchievement {
  id             String    @id @default(cuid())
  userId         String
  badge          BadgeTier
  streakAtUnlock Int
  unlockedAt     DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badge])
  @@index([userId, unlockedAt])
}

model TeamQuest {
  id            String             @id @default(cuid())
  teamId        String
  weekKey       String
  title         String
  targetWins    Int
  status        TeamQuestStatus    @default(ACTIVE)
  startAt       DateTime
  endAt         DateTime
  completedAt   DateTime?
  team          Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contributions QuestContribution[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([teamId, weekKey])
  @@index([teamId, status, startAt])
}

model QuestContribution {
  id           String    @id @default(cuid())
  questId      String
  userId       String
  localDate    String
  sourceTaskId String?
  quest        TeamQuest @relation(fields: [questId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTask   Task?     @relation(fields: [sourceTaskId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@unique([questId, userId, localDate])
  @@index([questId, createdAt])
}

model ProductEvent {
  id         String   @id @default(cuid())
  name       String
  userId     String?
  teamId     String?
  properties Json?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@index([teamId, createdAt])
}

enum Role {
  OWNER
  MEMBER
}

enum TaskStatus {
  OPEN
  DONE
}

enum Priority {
  NORMAL
  HIGH
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum NotificationKind {
  GENERAL
  TASK
  INVITE
  MOMENTUM
  QUEST
}

enum MomentumDayStatus {
  PENDING
  WIN
  SHIELDED
  MISSED
}

enum BadgeTier {
  SPARK
  RHYTHM
  FLOW
  DRIVE
  PEAK
  LEGACY
}

enum TeamQuestStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}
